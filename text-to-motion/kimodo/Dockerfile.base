# ==========================================
# STAGE 1: BUILDER
# ==========================================
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 python3-pip python3.10-dev python3.10-venv \
      git curl ca-certificates cmake build-essential \
    && rm -rf /var/lib/apt/lists/*

# Setup Python Virtual Environment
RUN python3.10 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# setuptools + wheel stay in the venv on purpose: Dockerfile.prod builds the kimodo
# wheel with --no-build-isolation, which needs them already present.
RUN pip install -U pip setuptools wheel

# This image is deps only — kimodo itself is installed by Dockerfile.prod. Only the
# lockfile and the C++ extension source are needed here.
COPY docker_requirements_prod.txt /workspace/
COPY MotionCorrection /workspace/MotionCorrection

# Third-party deps come from the committed lockfile, resolved ahead of time by
# `python kimodo/scripts/lock_requirements.py --prod`. --no-deps makes that lockfile the
# only authority: nothing is resolved at build time, so rebuilding a given base tag
# reproduces that tag instead of silently drifting onto newer versions.
RUN pip install --no-cache-dir --no-deps -r docker_requirements_prod.txt \
      --extra-index-url https://download.pytorch.org/whl/cu124

# Compile C++ MotionCorrection (pybind11 + Eigen; no CUDA involved). --no-deps matters:
# its install_requires says `torch>=1.10.0` with no index pin, so a resolving install
# could drag a second multi-GB torch down from plain PyPI. torch and numpy are already
# satisfied by the lockfile above.
RUN pip install --no-cache-dir --no-deps ./MotionCorrection

# Verify MotionCorrection compiled correctly
RUN python3.10 -c "import motion_correction; print('MotionCorrection OK')"

# Drop what only a compiler needs. C++ headers and static archives are never opened at
# runtime; every .so is left untouched.
RUN SP=/opt/venv/lib/python3.10/site-packages \
 && rm -rf "$SP/torch/include" "$SP/torch/test" \
 && find /opt/venv -name '*.a' -delete

# ==========================================
# STAGE 2: RUNTIME
# ==========================================
# `-base`, not `-runtime`. The torch cu124 wheels bundle their own cuBLAS / cuDNN /
# cuFFT / cuSOLVER / cuSPARSE under site-packages/nvidia and load those via
# torch._load_global_deps, so the copies inside the `-runtime` image were 1.37 GB
# (compressed) of libraries nothing ever dlopen'd. The CUDA driver still comes from the
# host through nvidia-container-runtime, and NVIDIA_VISIBLE_DEVICES /
# NVIDIA_DRIVER_CAPABILITIES are set by this image exactly as they were by `-runtime`.
FROM nvidia/cuda:12.4.1-base-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

# python3.10 backs the venv. curl is NOT optional: the ECS container health check is
# `curl -sS -o /dev/null http://localhost:8000/mcp` (infra/infra/kimodo_ecs_stack.py),
# so dropping it would leave the task permanently unhealthy. S3 syncing now goes
# through boto3 in the venv, so there is no AWS CLI here.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3.10 curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built Python environment. No source tree is copied: kimodo lands in
# exactly one place, and that place is Dockerfile.prod.
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Smoke test for shared libraries. The torch import is what proves the `-base` image
# still carries everything torch needs; a CUDA matmul cannot run at build time (no GPU)
# and is checked on ECS instead.
RUN ldd /opt/venv/lib/python3.10/site-packages/motion_correction/*.so \
    && python3.10 -c "import torch; import motion_correction; print('Runtime OK')"

# Configure entrypoint script
COPY scripts/inference-entrypoint.sh /usr/local/bin/inference-entrypoint
COPY scripts/s3_sync.py /usr/local/bin/s3_sync.py
RUN chmod +x /usr/local/bin/inference-entrypoint

EXPOSE 8000
ENTRYPOINT ["inference-entrypoint"]
