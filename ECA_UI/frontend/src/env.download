# Local development against the `ampx sandbox` Cognito pool.
#
# The pool itself comes from amplify_outputs.json, which `npx ampx sandbox`
# wrote — that is why there is no VITE_USER_POOL_ID here. The backend points at
# the same pool (agenticRAG/.env), so a token minted by logging in below is
# accepted by both local services.
#
# Dev user: dev@vva.local / DevVva#2026x
# Google sign-in will NOT work here: the sandbox holds a placeholder client
# secret, and the new pool's redirect URI is not registered with Google.

# Auth gate. Commented out on purpose — with it true the app skips the login
# screen and sends no token, and every API call comes back 401 now that the
# backend takes identity only from a verified token. Uncomment only to work on
# the login screen or the layout itself.
# VITE_AUTH_DISABLED=true

# What needs the graph: /chat (SSE), /tts, /billing.
#
# 8010, not 8000: another project on this machine runs a devserver there. The
# same reason .env.example warns off 8080.
VITE_API_BASE_URL=http://localhost:8000

# Sessions and user memory. A separate service, which is the point: stopping the
# agent on :8000 must not take the session list with it.
#     uvicorn langgraph_agents.api.crud_app:create_crud_app --factory --port 8001
VITE_CRUD_API_URL=http://localhost:8001

# API Gateway in front of the auth Lambdas (lookup-email, set-password,
# link-google). The login screen asks for an email first and calls lookup-email
# to decide what to show next, so without this the first step fails with
# "Failed to fetch" before any password is even typed.
#
# Value is custom.authApiUrl from amplify_outputs.json, written by
# `npx ampx sandbox`. Keep the trailing slash.
VITE_AUTH_API_URL=https://573v3v8kv5.execute-api.us-east-1.amazonaws.com/prod/

VITE_GOOGLE_CLIENT_ID=769846845374-ohk7c643e7sv3lng9fjs4koo4i89js3c.apps.googleusercontent.com

VITE_ASSET_BASE_URL=https://d3292v7f15b95x.cloudfront.net
