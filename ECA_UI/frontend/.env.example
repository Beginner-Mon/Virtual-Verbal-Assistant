# VVA Frontend environment variables
# Copy to .env.local for local development

# Backend API base URL (default: http://localhost:8000)
# NOTE: port 8080 is reserved on this machine (Owner's Spring service) — do not use it.
# Serves the streaming chat API: /chat (SSE), /sessions, /tts, /billing.
VITE_API_BASE_URL=http://localhost:8000

# ── Characters & VRM assets ──────────────────────────────────────────────────
# A SECOND origin, on purpose. This one is the CloudFront distribution from
# VvaAssetStack: it serves the .vrm models from S3 and routes /characters* to
# the vva-characters Lambda. Chat stays on VITE_API_BASE_URL above — SSE is not
# sent through the CDN, where buffering would break token streaming.
#
# Value is the AssetStack CfnOutput "AssetBaseUrl", no trailing slash.
# VITE_ASSET_BASE_URL=https://d111111abcdef8.cloudfront.net


# ── Auth ─────────────────────────────────────────────────────────────────────
# Skip the sign-in gate entirely. Only valid while the backend runs with
# REQUIRE_AUTH=false — with auth required, a bypassed frontend sends no token and
# every request comes back 401.
VITE_AUTH_DISABLED=true

# Amplify / Cognito.
#
# Two ways to configure it, checked in this order:
#   1. amplify_outputs.json, written by `npx ampx sandbox` (needs AWS credentials)
#   2. the variables below
#
# Use these to point a local frontend at a Cognito pool that already exists,
# without generating outputs. Neither present ⇒ demo mode: no sign-in, no
# Authorization header.
#
# Minimum for email/password sign-in:
# VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
# VITE_USER_POOL_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Also required for "Continue with Google" — the hosted UI domain the browser is
# redirected to. Without it email/password still works and Google does not.
# Note this is the DOMAIN ONLY, no scheme and no path.
# VITE_COGNITO_DOMAIN=eca-us-east-1.auth.us-east-1.amazoncognito.com
#
# Optional: the region is derived from the pool id prefix when omitted.
# VITE_COGNITO_REGION=us-east-1
#
# API Gateway base for the auth Lambdas (set-password, lookup-email,
# link-google). Normally amplify_outputs.custom.authApiUrl. Those three screens
# fail without it; sign-in itself does not need it. Keep the trailing slash.
# VITE_AUTH_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/
#
# Google client id for linking Google from Profile. This is a PUBLIC value, not a
# secret. The app's origin must also be listed under "Authorized JavaScript
# origins" in the Google Cloud console, or the button silently fails to render.
# VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
