# VVA Frontend environment variables
# Copy to .env.local for local development

# Backend API base URL (default: http://localhost:8000)
# NOTE: port 8080 is reserved on this machine (Owner's Spring service) — do not use it.
# Serves what needs the graph: /chat (SSE), /tts, /billing.
VITE_API_BASE_URL=http://localhost:8000

# Sessions and user memory (/sessions, /me/memory). A separate origin because
# those endpoints moved to their own Lambda — serving a session list should not
# require keeping the agent alive, since that process imports torch at boot to
# run a few SQL statements.
#
# Falls back to VITE_API_BASE_URL when unset, which is what you want while
# running everything from one local uvicorn. Point it at :8001 to exercise the
# split locally:
#     uvicorn langgraph_agents.api.crud_app:create_crud_app --factory --port 8001
# VITE_CRUD_API_URL=http://localhost:8001

# ── Characters & VRM assets ──────────────────────────────────────────────────
# A SECOND origin, on purpose. This one is the CloudFront distribution from
# VvaAssetStack: it serves the .vrm models from S3 and routes /characters* to
# the vva-characters Lambda. Chat stays on VITE_API_BASE_URL above — SSE is not
# sent through the CDN, where buffering would break token streaming.
#
# Value is the AssetStack CfnOutput "AssetBaseUrl", no trailing slash.
# VITE_ASSET_BASE_URL=https://d111111abcdef8.cloudfront.net


# ── Auth ─────────────────────────────────────────────────────────────────────
# Skip the sign-in gate so you can reach the app shell without logging in.
#
# This is a UI switch and nothing more. The backend has no matching flag any
# more: it takes identity only from a verified token, in every environment, so
# with the gate bypassed you get the shell and every API call returns 401. Useful
# for working on the login screen itself or on layout; not a way to use the app.
#
# To actually use the app locally, sign in against your own `npx ampx sandbox`
# pool. For curl, mint a token with scripts/dev_token.ps1.
#
# Commented out deliberately. This file is meant to be copied to .env.local, so
# an uncommented value here is the default every new developer starts from — and
# starting from "gate bypassed" means starting from an app whose every request
# returns 401, with no visible reason why. Uncomment only for work on the login
# screen itself.
# VITE_AUTH_DISABLED=true

# Amplify / Cognito.
#
# Two ways to configure it, checked in this order:
#   1. amplify_outputs.json, written by `npx ampx sandbox` (needs AWS credentials)
#   2. the variables below
#
# Use these to point a local frontend at a Cognito pool that already exists,
# without generating outputs. Neither present ⇒ demo mode: no sign-in, no
# Authorization header.
#
# Minimum for email/password sign-in:
# VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
# VITE_USER_POOL_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Also required for "Continue with Google" — the hosted UI domain the browser is
# redirected to. Without it email/password still works and Google does not.
# Note this is the DOMAIN ONLY, no scheme and no path.
# VITE_COGNITO_DOMAIN=eca-us-east-1.auth.us-east-1.amazoncognito.com
#
# API Gateway base for the auth Lambdas (set-password, lookup-email,
# link-google). Normally amplify_outputs.custom.authApiUrl. Those three screens
# fail without it; sign-in itself does not need it. Keep the trailing slash.
# VITE_AUTH_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod/
#
# VITE_COGNITO_REGION and VITE_GOOGLE_CLIENT_ID were documented here until 19-08
# and removed: nothing read either one. The region is derived from the pool id,
# and the Google client id reaches the browser through
# amplify_outputs.custom.googleClientId (see lib/googleLink.ts) — backend.ts even
# says "the frontend never needs its own VITE_GOOGLE_CLIENT_ID". Setting them did
# nothing, which is worse than not offering them, because this file is what every
# new developer copies.


# ── Amplify BACKEND variables (not Vite) ─────────────────────────────────────
# Read via process.env at `ampx` SYNTH time, not by the browser. Vite ignores
# them; putting them in .env.local has no effect. Set them in the Amplify Console
# branch environment, or in ECA_UI/frontend/.env for a local `ampx sandbox`.
#
# The production web origin. It is wired into the CORS allow-list AND the Cognito
# OAuth redirect/logout URIs at deploy time, so a missing value deploys a stack
# whose sign-in redirect points nowhere — with no error at build time.
# WEB_APP_ORIGIN=https://<branch>.<app-id>.amplifyapp.com
#
# Google OAuth client id. Public. The client SECRET goes in the Amplify secret
# store only — never here.
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
