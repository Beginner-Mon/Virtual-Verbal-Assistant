# VVA Frontend environment variables
# Copy to .env.local for local development

# Backend API base URL (default: http://localhost:8080)
# Override if backend runs on a different port or host.
VITE_API_BASE_URL=http://localhost:8080

# Amplify / Cognito auth (optional — demo mode works without this)
# If amplify_outputs.json is absent, no auth header is sent and the backend
# falls back to demo user_id (REQUIRE_AUTH=false mode).
# VITE_COGNITO_REGION=us-east-1
# VITE_USER_POOL_ID=us-east-1_xxxxx
# VITE_USER_POOL_WEB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
