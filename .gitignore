.vscode/
RUN_SERVERS.md
INTEGRATION_SETUP.md

# Python cache artifacts
__pycache__/
*.py[cod]
.pytest_cache/

# Virtualenvs and build output, at ANY depth.
#
# These used to be covered only by per-directory .gitignore files that happened
# to sit in the right place — infra/, ECA_UI/frontend/, text-to-motion/DART/.
# agenticRAG/, the largest first-party Python package, has no .gitignore of its
# own at all, so a venv created there was completely untracked-but-unignored and
# one `git add -A` away from being committed.
#
# `.venv*` rather than `.venv`: DART needed a bespoke `.venv-mcp/` line at
# .gitignore:186 precisely because a bare `.venv` does not match `.venv-mcp`.
# NOT `env/`: text-to-motion/DART/control/env is source code
# (env_reach_location_mld.py), not a virtualenv. A bare `env/` rule would make it
# permanently un-addable, and the failure would look like "git is losing my file".
.venv*/
venv/
node_modules/
dist/
build/
cdk.out/
.cdk.staging/
*.egg-info/

# Runtime logs and temp outputs
*.log
logs/

# Celery runtime state
agenticRAG/agentic_rag_gemini/celerybeat-schedule.bak
agenticRAG/agentic_rag_gemini/celerybeat-schedule.dat
agenticRAG/agentic_rag_gemini/celerybeat-schedule.dir

# Generated media outputs
agenticRAG/agentic_rag_gemini/static/videos/
agenticRAG/agentic_rag_gemini/static/motions/

# Local runtime/session artifacts
agenticRAG/agentic_rag_gemini/memory/chat_history/
memory/chat_history/

# Local debug and ad-hoc test outputs
agenticRAG/agentic_rag_gemini/api_results*.txt
agenticRAG/agentic_rag_gemini/debug_out.txt
agenticRAG/agentic_rag_gemini/debug_startup.py
tmp_query*.json

# Local caches
text-to-motion/DART/data_loaders/humanml/data/__pycache__/

# Local Chroma volume data
chroma_data/

# Secrets — NEVER commit env files (API keys, DSNs)
.env
.env.*
!.env.example
**/firebase-service-account.json
**/service-account*.json
*.pem
*.key
!*.pub.key

# Amplify sandbox outputs (per-developer)
ECA_UI/frontend/amplify_outputs.json
opencode.json

# Local tooling state (per-machine, not project state)
.playwright-cli/
.opencode/
.agents/
.claude/worktrees/
.claude/settings.json
.claude/settings.local.json
.claude/skills/
.claude/karpathy-guidelines.md
skills-lock.json
.opencode/*

# Kimodo — license-restricted SMPL-X models (MPI); user must download separately
text-to-motion/kimodo/**/model.pkl
text-to-motion/kimodo/**/SMPLX_NEUTRAL.npz

# Kimodo — S3-downloaded assets (models, configs, etc.)
kimodo-s3-assets/

# Kimodo — embedded git repo; use submodule or vendor properly
text-to-motion/kimodo/kimodo-viser/


# Knowledge-base corpora.
#
# documents.txt (1.1 MB) IS tracked — it is the source of the 2918-record
# exercise KB and the only copy outside one laptop.
#
# humanml3d_descriptions.jsonl is not: 8 MB, regenerable with
# scripts/download_humanml3d.py, and nothing in the current service reads it.
# Kept on disk after agentic_rag_gemini was deleted so a future HumanML3D
# ingest does not start with a download.
data/knowledge_base/humanml3d_descriptions.jsonl

# Exported ONNX model for the embedding runtime — ~465 MB, reproducible from
# scripts/export_e5_onnx.py, and baked into the Lambda image at build time by a
# throwaway Docker stage. Never commit it.
models/
